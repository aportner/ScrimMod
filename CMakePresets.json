{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux GCC i386 Release",
      "description": "Build the 32-bit Linux MetaMod-R plugin and core tests with GCC",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-gcc-i386.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SCRIMMOD_BUILD_PLUGIN": "ON",
        "SCRIMMOD_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
